rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function userRecord() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }
    function activeUser() {
      return signedIn()
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && userRecord().status == 'active'
        && userRecord().schoolId == 'ctla';
    }
    function activeIdentityId() {
      let profileId = userRecord().activeMemberId;
      return profileId is string ? profileId : request.auth.uid;
    }
    function conversationMember(conversationId) {
      let conversation = firestore.get(/databases/(default)/documents/conversations/$(conversationId)).data;
      let profileId = activeIdentityId();
      return activeUser()
        && firestore.exists(/databases/(default)/documents/conversations/$(conversationId))
        && (conversation.memberProfileIds is list
          ? (profileId in conversation.memberProfileIds
            && profileId is string)
          : (profileId == request.auth.uid && request.auth.uid in conversation.memberUids));
    }
    function conversationManager(conversationId) {
      return activeUser()
        && firestore.exists(/databases/(default)/documents/conversations/$(conversationId))
        && ((firestore.get(/databases/(default)/documents/conversations/$(conversationId)).data.createdByIdentityId is string
            && firestore.get(/databases/(default)/documents/conversations/$(conversationId)).data.createdByIdentityId == activeIdentityId()
            && conversationMember(conversationId))
          || (!(firestore.get(/databases/(default)/documents/conversations/$(conversationId)).data.memberProfileIds is list)
            && firestore.get(/databases/(default)/documents/conversations/$(conversationId)).data.createdBy == request.auth.uid
            && activeIdentityId() == request.auth.uid)
          || (activeIdentityId() == request.auth.uid && userRecord().role in ['presidency', 'admin']));
    }

    match /conversations/{conversationId}/{uid}/{fileName} {
      allow read: if conversationMember(conversationId);
      allow create: if conversationMember(conversationId)
        && request.auth.uid == uid
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*|application/pdf|text/plain|application/msword|application/vnd.openxmlformats-officedocument.wordprocessingml.document');
      allow delete: if conversationManager(conversationId);
      allow update: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
